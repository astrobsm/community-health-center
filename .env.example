# =============================================================================
# Community Health Centre Platform — environment configuration
#
# Copy to .env and fill in. NEVER commit .env.
# Every variable is required unless marked OPTIONAL.
# Generate secrets with:  openssl rand -base64 48
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development                  # development | test | staging | production
LOG_LEVEL=debug                       # trace|debug|info|warn|error
TZ=UTC                                # storage clock; display timezone is per-organisation
DISPLAY_TIMEZONE=Africa/Lagos

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
API_PORT=3000
API_HOST=0.0.0.0
API_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
API_BODY_LIMIT_BYTES=1048576          # 1 MB; media goes to object storage, not through the API

# -----------------------------------------------------------------------------
# PostgreSQL
#
# Two roles on purpose:
#   MIGRATION role  — owns the schema, bypasses RLS
#   APP role        — runtime, subject to RLS (see ADR 0005)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://chc_app:CHANGE_ME@localhost:5432/chc?schema=public
DATABASE_MIGRATION_URL=postgresql://chc_migrator:CHANGE_ME@localhost:5432/chc?schema=public
DATABASE_POOL_MAX=20
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_SSL=false                    # true in production

# Read-only role for the AI layer — analytics schema only (see 17-ai-architecture.md)
DATABASE_AI_READONLY_URL=postgresql://ai_reader:CHANGE_ME@localhost:5432/chc?schema=analytics

# -----------------------------------------------------------------------------
# Redis — cache, rate limiting, BullMQ, token revocation
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=chc:

# -----------------------------------------------------------------------------
# Authentication
#
# JWT uses EdDSA (Ed25519). Generate a keypair:
#   openssl genpkey -algorithm ed25519 -out jwt-private.pem
#   openssl pkey -in jwt-private.pem -pubout -out jwt-public.pem
# Supply as base64 of the PEM:  base64 -w0 jwt-private.pem
# -----------------------------------------------------------------------------
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_KEY_ID=key-2026-09
JWT_ISSUER=chc-platform
JWT_AUDIENCE=chc-api
ACCESS_TOKEN_TTL_SECONDS=600          # 10 minutes
REFRESH_TOKEN_TTL_DAYS=30             # long, because field devices go offline for weeks
REFRESH_TOKEN_PEPPER=

# Argon2id — tune so a hash takes roughly 250 ms on the target host
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# MFA
MFA_ISSUER=CHC Platform
MFA_REQUIRED_ROLES=SUPER_ADMIN,ORG_ADMIN,FINANCE_OFFICER,AUDITOR

# Offline authentication (see 07-authentication.md §5)
OFFLINE_GRACE_PERIOD_DAYS=7
OFFLINE_MAX_FAILED_ATTEMPTS=10
OFFLINE_DISALLOWED_ROLES=SUPER_ADMIN,ORG_ADMIN,FINANCE_OFFICER,AUDITOR

# -----------------------------------------------------------------------------
# Object storage (S3-compatible; MinIO in development)
# -----------------------------------------------------------------------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET_EVIDENCE=chc-evidence
STORAGE_BUCKET_DOCUMENTS=chc-documents
STORAGE_BUCKET_BACKUPS=chc-backups
STORAGE_FORCE_PATH_STYLE=true         # true for MinIO
STORAGE_PRESIGN_TTL_SECONDS=900

# Field-level encryption key for sensitive columns (NIN, phone, bank details)
FIELD_ENCRYPTION_KEY_BASE64=
FIELD_ENCRYPTION_KEY_VERSION=1

# -----------------------------------------------------------------------------
# Notifications — OPTIONAL; features stay disabled until configured
# -----------------------------------------------------------------------------
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025                        # Mailpit in development
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="CHC Platform <noreply@example.org>"

SMS_ENABLED=false
SMS_PROVIDER=                         # termii | africastalking | twilio
SMS_API_KEY=
SMS_SENDER_ID=

# -----------------------------------------------------------------------------
# AI layer — OPTIONAL. With AI_ENABLED=false every other feature still works.
# -----------------------------------------------------------------------------
AI_ENABLED=false
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL_ANALYSIS=claude-opus-5
AI_MODEL_SUMMARY=claude-sonnet-5
AI_MAX_TOKENS_PER_ORG_PER_DAY=500000
AI_REQUIRE_GROUNDING=true             # reject any response containing an ungrounded figure

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_GENERAL_PER_MINUTE=300
RATE_LIMIT_WRITE_PER_MINUTE=60
RATE_LIMIT_LOGIN_PER_15MIN=5
RATE_LIMIT_SYNC_BATCHES_PER_MINUTE=10
SYNC_MAX_RECORDS_PER_BATCH=50

# -----------------------------------------------------------------------------
# Backups (see 19-backup-disaster-recovery.md)
# -----------------------------------------------------------------------------
BACKUP_ENABLED=false
BACKUP_SCHEDULE_CRON=0 2 * * *
BACKUP_ENCRYPTION_KEY_BASE64=
BACKUP_RETENTION_DAILY_DAYS=30
BACKUP_RETENTION_WEEKLY_WEEKS=12
BACKUP_RETENTION_MONTHLY_MONTHS=24
BACKUP_VERIFY_ENABLED=true
BACKUP_ALERT_IF_STALE_HOURS=48

# -----------------------------------------------------------------------------
# Observability — OPTIONAL
# -----------------------------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
METRICS_ENABLED=true

# -----------------------------------------------------------------------------
# Analytics refresh cadence (minutes)
# -----------------------------------------------------------------------------
MATVIEW_REFRESH_CLINICAL_MINUTES=15
MATVIEW_REFRESH_FINANCIAL_MINUTES=15
MATVIEW_REFRESH_STOCK_MINUTES=10
MATVIEW_REFRESH_KPI_MINUTES=60

# -----------------------------------------------------------------------------
# Safety switches — do not change without understanding the consequences
# -----------------------------------------------------------------------------
ALLOW_DEMO_FIXTURES=false             # MUST be false in production; blocks seeding fake clinical
                                      # and financial records (spec §91)
STRICT_CLASSIFICATION=true            # refuse to serialise an unlabelled quantitative value
