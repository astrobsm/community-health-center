{
  "name": "@chc/api",
  "version": "0.1.0",
  "private": true,
  "description": "Community Health Centre Platform API, workers and database schema",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir src --exclude \"**/*.integration.spec.ts\"",
    "test:watch": "vitest --dir src",
    "test:coverage": "vitest run --coverage --dir src",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:acceptance": "vitest run --config vitest.integration.config.ts --dir test/acceptance",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:erd": "node scripts/generate-erd.mjs",
    "db:verify": "bash scripts/verify-invariants.sh",
    "db:test-migrate": "bash scripts/test-migrations.sh"
  },
  "dependencies": {
    "@chc/contracts": "*",
    "@fastify/helmet": "^12.0.1",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/event-emitter": "^2.1.1",
    "@nestjs/platform-fastify": "^10.4.15",
    "@nestjs/schedule": "^4.1.1",
    "@prisma/client": "^6.2.1",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.5",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "nanoid": "^5.0.9",
    "otpauth": "^9.3.6",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.15",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^2.1.8",
    "prisma": "^6.2.1",
    "supertest": "^7.0.0",
    "testcontainers": "^10.16.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
