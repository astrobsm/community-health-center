{
  "name": "community-health-centre-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Community Health Centre Revitalisation, Partnership, EMR & Facility Management Platform",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm run dev --workspace @chc/api",
    "dev:web": "npm run dev --workspace @chc/web",
    "build": "npm run build --workspace @chc/contracts && npm run build --workspace @chc/api && npm run build --workspace @chc/web",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace @chc/api",
    "test:e2e": "npm run test:e2e --workspace @chc/web",
    "test:acceptance": "npm run test:acceptance --workspace @chc/api",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "db:migrate": "npm run db:migrate --workspace @chc/api",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace @chc/api",
    "db:seed": "npm run db:seed --workspace @chc/api",
    "db:studio": "npm run db:studio --workspace @chc/api",
    "db:erd": "npm run db:erd --workspace @chc/api",
    "db:reset": "npm run db:reset --workspace @chc/api",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker/docker-compose.yml logs -f",
    "infra:reset": "docker compose -f infra/docker/docker-compose.yml down -v",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "npm-run-all2": "^7.0.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
